+    money_target_sentences: moneyTargets,
+    outcome_language: OUTCOME_LANGUAGE.test(t),
+    prediction_language: PREDICTION.test(t),
+    control_language: CONTROL_LANGUAGE.test(t),
+    chars: t.length,
+  };
+  const warnings = [];
+  if (moneyTargets) throw Object.assign(invalid('That is an outcome goal: it names an amount and an outcome in the same sentence. The saved rule asks for one process, behavioral rule within your control — “Today I follow my plan”, “Today I will take only A+ setups”, “Today I will journal every trade”, “Today I will not revenge trade”. The app will not store a money target as your intention (journal text is untouched).'), { code: 'intention_outcome_target' });
