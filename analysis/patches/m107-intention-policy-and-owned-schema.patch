+  if (value === null) return null;
+  if (typeof value !== 'string' || !value.trim() || value.length > CHAR_MAX || /[\x00-\x1f\x7f]/.test(value)) throw invalid(`Write one single-line intention up to ${CHAR_MAX} characters.`);
