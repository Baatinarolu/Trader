+  if (!a) throw invalid('Account not found.', 404);
+  return a;
+}
+const rowsOn = (store, userId, accountId) => store.prepare('SELECT * FROM daily_intentions WHERE user_id=? AND account_key=? ORDER BY id').all(userId, accountId);
+
+function evaluate(rows, accountId, { nowMs = Date.now(), date = null } = {}) {
+  const today = utcDay(nowMs);
+  let day = today;
+  if (date !== null) {
+    try { dateKey(date); } catch { return { ...empty(accountId, today, today), state: 'unavailable', message: 'Invalid requested date.' }; }
+    day = date;
+  }
+  const all = (rows || []).filter((r) => r && typeof r === 'object');
+  const archives = all.filter((r) => r.source === 'imported_unverified');
+  const human = all.filter((r) => r.source === 'human_declared');
+  const onDay = human.filter((r) => r.day === day);
+  const before = human.filter((r) => typeof r.day === 'string' && r.day !== '' && r.day < day).slice(-1)[0] || null;
+  const base = {
+    schema: VERSION, account_id: accountId, day, today, same_day: day === today, state: 'unrecorded', template: null, text: null,
+    framing: null, cues: null, warnings: [], receipt: null, version: null, templates: TEMPLATES, char_max: CHAR_MAX,
+    authority: 'none', imported_archives: archives.length, last_recorded: before ? publicRow(before) : null,
