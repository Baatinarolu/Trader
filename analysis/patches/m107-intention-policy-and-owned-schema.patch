+const PREDICTION = /\b(will\s+(?:go|rise|fall|drop|moon|pump)|is\s+going\s+to\s+(?:go|rise|fall|drop)|market\s+will|price\s+will)\b/i;
+const CONTROL_LANGUAGE = /\b(calm|patient|disciplined|focused|no\s+fomo|not\s+revenge|follow\s+my\s+plan|journal|wait|only\s+a\+|respect\s+my\s+stop|risk\s+only)\b/i;
+const sentences = (t) => t.split(/[.!?]+/).map((s) => s.trim()).filter(Boolean);
+
+function invalid(message, status = 400) { return Object.assign(new Error(message), { code: 'intention_invalid', status }); }
+
+/** One single-line sentence, bounded; the episode asks for "one simple sentence". */
