+    const tpl = row.template_id ? templateById(row.template_id) : null;
+    if (row.framing === 'process_template' && (!tpl || tpl.text !== value)) throw invalid('Unavailable template intent.');
+    if (!['process_template', 'unverified_free_text', 'outcome_language'].includes(row.framing)) throw invalid('Unavailable intention framing.');
