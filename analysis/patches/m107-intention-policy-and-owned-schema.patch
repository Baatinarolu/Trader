+}
+function warningsFor(framing, cues) {
+  const out = [];
+  if (!cues || typeof cues !== 'object') return ['cues_unavailable: the recorded cues cannot be read back, so nothing is inferred.'];
+  if (framing === 'outcome_language') out.push('outcome_language: this reads as an outcome rather than a behavior. Outcomes are a byproduct of the process; the app stores your words as unverified.');
+  if (cues.prediction_language) out.push('prediction_language: the app does not verify market predictions or treat them as a plan.');
+  if (cues.sentences > 1) out.push('multiple_sentences: the saved rule asks for ONE simple sentence for the day.');
+  if (cues.chars > 90) out.push('long_text: kept as written, but a one-line rule is easier to hold to.');
+  if (framing === 'unverified_free_text') out.push('not_process_verified: free text is not machine-checkable, so the app does not label it process-oriented — only the saved templates carry that label.');
+  return out;
+}
+const templateById = (id) => TEMPLATES.find((t) => t.id === id) || null;
+
+/** Body is exactly one of a template id or free text, plus the displayed revision. */
+function input(body) {
+  const allowed = ['template', 'intention', 'revision'];
+  if (!body || typeof body !== 'object' || Array.isArray(body) || Object.keys(body).some((k) => !allowed.includes(k)) || typeof body.revision !== 'string' || !/^[a-f0-9]{64}$/.test(body.revision)) throw invalid('Send the displayed revision and either a saved template id or your own one-line intention; no caller clock, day, source or owner authority is accepted.');
+  const hasTemplate = Object.hasOwn(body, 'template') && body.template !== null;
+  const hasText = Object.hasOwn(body, 'intention') && body.intention !== null;
+  if (hasTemplate === hasText) throw invalid('Choose ONE saved template or write your own intention — not both, and not neither.');
+  if (hasTemplate) {
+    const t = templateById(body.template);
+    if (!t) throw invalid('Unknown saved template.');
+    const c = classify(t.text);
+    return { template: t.id, text: t.text, framing: 'process_template', cues: c.cues, revision: body.revision };
+  }
+  const value = text(body.intention);
+  const c = classify(value);
+  return { template: null, text: value, framing: c.framing === 'process_template' ? 'unverified_free_text' : c.framing, cues: c.cues, revision: body.revision };
+}
+
+const id = (n) => Number.isSafeInteger(n) && n > 0;
+const hash = (v) => crypto.createHash('sha256').update(JSON.stringify(v)).digest('hex');
+const Clock = (s, o) => require('./process-outcomes').clock(s, o);
+const utcDay = (ms) => new Date(ms).toISOString().slice(0, 10);
+function dateKey(value) {
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value) || Clock(value + 'T00:00:00.000Z', { canonical: true }) === null) throw invalid('Use a valid UTC calendar date.');
+  return value;
+}
+function dayKey(value) {
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value) || Clock(value + 'T00:00:00.000Z', { canonical: true }) === null) throw invalid('Use a valid UTC calendar date (YYYY-MM-DD).');
+  return value;
+}
+function publicRow(row) {
+  if (!row) return null;
+  try {
+    if (!['human_declared', 'imported_unverified'].includes(row.source) || row.schema_version !== VERSION || !id(row.account_key) || (row.account_id !== null && row.account_id !== row.account_key) || !id(row.version) || Clock(row.recorded_at, { canonical: true }) === null || typeof row.day !== 'string') throw invalid('Unavailable daily intention record.');
