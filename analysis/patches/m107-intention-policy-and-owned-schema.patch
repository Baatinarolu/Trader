+'use strict';
+/**
+ * M107 — the day's ONE process intention.
+ *
+ * Saved Ep28: "you can set one clear rule for the day ... keep it as one simple sentence,
+ * and you want to make it process-oriented. You want to make it behavioral. You want to
+ * make it so that it's within your control. You can't say stupid stuff like 'Today, I'm
+ * going to make $5,000 from the market.' No, that's outside of your control ... that's an
+ * outcome-focused goal, which only happens as a byproduct of you following the process."
+ * Worked examples: "Today I follow my plan", "Today I will take only A+ setups", "Today I
+ * will journal every trade", "Today I will not revenge trade."
+ *
+ * The app cannot judge whether free text is process-oriented, so it does not pretend to.
+ * A curated template is labelled as the saved example it is; free text is stored as
+ * UNVERIFIED with the cues a bounded classifier actually found; and a money/profit target
+ * (an amount AND an outcome verb in the same sentence) is REFUSED, because the episode is
+ * unambiguous that it is worse than no intention at all: it sets an outcome target that
+ * pressures sizing. This module has NO permission authority — it never admits, refuses,
+ * scores or gates a trade, and it never rewrites journal text. Absence is never a failure
+ * and a recorded intention is never evidence that it was followed.
+ */
+const crypto = require('crypto');
+const VERSION = 'intention-v1';
+const CHAR_MAX = 120;
+/** The four worked examples from the episode, kept verbatim as curated choices. */
+const TEMPLATES = [
+  { id: 'follow_plan', text: 'Today I follow my plan', label: 'Follow my plan' },
+  { id: 'a_plus_only', text: 'Today I will take only A+ setups', label: 'A+ setups only' },
+  { id: 'journal_every_trade', text: 'Today I will journal every trade', label: 'Journal every trade' },
+  { id: 'no_revenge', text: 'Today I will not revenge trade', label: 'No revenge trade' },
+];
+const BASIS = 'One same-day process intention recorded by the trader: a curated saved example or free text kept UNVERIFIED with the cues the bounded classifier found. Not a readiness gate, not verified discipline or plan adherence, no score, no permission over entries/signals/risk/grade/core, and never proof that the intention was followed. A money/profit target is refused here; the app does not judge free text in general.';
+
+/* A bounded, explainable classifier. These are the app's own cues, not a reading of the
+ * trader's mind: an amount and an outcome verb in the SAME sentence is the one pairing the
+ * episode names, so that is the one refusal. Everything else is a label, never a verdict. */
+const AMOUNT = /(?:[$€£]\s?\d[\d,.]*)|(?:\b\d[\d,.]*\s?(?:usd|eur|gbp|dollars?|euros?|pounds?|naira|k)\b)|(?:\b\d+(?:\.\d+)?\s?%)/i;
