+  if (cues.outcome_language) warnings.push('outcome_language: this reads as an outcome rather than a behavior. Outcomes are a byproduct of the process; the app stores your words as unverified.');
+  if (cues.prediction_language) warnings.push('prediction_language: the app does not verify market predictions or treat them as a plan.');
+  if (cues.sentences > 1) warnings.push('multiple_sentences: the saved rule asks for ONE simple sentence for the day.');
+  if (cues.chars > 90) warnings.push('long_text: kept as written, but a one-line rule is easier to hold to.');
+  if (framing === 'unverified_free_text') warnings.push('not_process_verified: free text is not machine-checkable, so the app does not label it process-oriented — only the saved templates carry that label.');
