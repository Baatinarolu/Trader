+  if (receipt === null || receipt > nowMs) return { ...base, state: 'unavailable', message: 'The recorded intention receipt cannot be trusted, so nothing is claimed about that day.' };
+  const pub = publicRow(last);
+  if (pub.state === 'unavailable') return { ...base, state: 'unavailable', message: 'The recorded intention cannot be read back, so nothing is claimed about that day.' };
