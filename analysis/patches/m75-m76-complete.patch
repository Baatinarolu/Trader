+}
+function note(p) {
+  return `Stop ${p.source_tf || 'unknown TF'} ${p.kind || 'unknown'} at ${p.stop}; base ${p.base}, buffer ${p.buffer}; ${p.rule}. `;
+}
+module.exports.check = check;
+module.exports.note = note;
