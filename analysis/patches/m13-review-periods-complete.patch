+  if (kind === 'quarter') return `${start.slice(0, 4)}-Q${Math.floor(Number(start.slice(5, 7)) / 3) + 1}`;
+  if (kind === 'year') return start.slice(0, 4);
+  return start;
+}
+
+/** The canonical periods ending at `endStart`, newest first. `count` is bounded by the caller's budget. */
+function sequence(kind, endStart, count) {
+  const p = canonical(kind, endStart);
+  if (!Number.isSafeInteger(count) || count < 1 || count > 520) throw invalid('Choose between 1 and 520 periods.');
+  const out = [p];
+  let cursor = p.start;
+  while (out.length < count) {
+    const d = new Date(cursor + 'T00:00:00.000Z');
+    if (kind === 'week') d.setUTCDate(d.getUTCDate() - 7);
+    else if (kind === 'year') d.setUTCFullYear(d.getUTCFullYear() - 1);
+    else d.setUTCMonth(d.getUTCMonth() - (kind === 'quarter' ? 3 : 1));
+    cursor = iso(d);
+    out.push(period(kind, cursor));
+  }
+  return out;
+}
+
+/** A human label for a canonical start. Never a claim about the period's contents. */
+function label(kind, start) {
+  const p = canonical(kind, start), y = start.slice(0, 4), m = Number(start.slice(5, 7));
+  if (kind === 'week') return `Week of ${start}`;
+  if (kind === 'month') return `${['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'][m - 1]} ${y}`;
+  if (kind === 'quarter') return `Q${Math.floor((m - 1) / 3) + 1} ${y}`;
+  return y;
+}
+
