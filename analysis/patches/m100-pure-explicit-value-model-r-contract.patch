+}
+function aggregate(rows){const out={opportunities:rows.length,reported_missed_value:0,app_eligible_missed:0,unverified_value_missed:0,acted_app:0,acted_declared:0,unreviewed:0,unknown:0,not_taken:0,not_value:0,prior:0,unavailable:0,imported:0,complete_missed_total:null,broker_verified:false,basis:'Count explicit OWNED opportunity record-day decisions/links, not unused signals or simulated wins. Self-reported value/inaction, not broker/causal/probability/permission proof.'};for(const r of rows){if(!r){out.unknown++;continue;}if(['prior','unavailable','imported'].includes(r.state)){out[r.state]++;continue;}if(r.acted){out[r.acted_basis==='recorded_app_entry_link'?'acted_app':'acted_declared']++;continue;}if(r.missed){out.reported_missed_value++;out[r.missed_basis==='app_eligible_self_report'?'app_eligible_missed':'unverified_value_missed']++;}else if(Object.hasOwn(out,r.decision))out[r.decision]++;else out.unknown++;}if(out.unreviewed+out.unknown+out.prior+out.unavailable+out.imported===0)out.complete_missed_total=out.reported_missed_value;return out;}
