+function input(body){if(!body||typeof body!=='object'||Array.isArray(body)||Object.keys(body).some(k=>!['revision','decision','value_setup','reason_code','note'].includes(k))||typeof body.revision!=='string'||!/^[a-f0-9]{64}$/.test(body.revision)||!DECISIONS.includes(body.decision)||!Object.hasOwn(body,'value_setup')||body.value_setup!==null&&typeof body.value_setup!=='boolean'||typeof body.note!=='string'||body.note.length>2000||/[\x00\x08\x0b\x0c\x7f]/.test(body.note))throw invalid('Use displayed revision/explicit decision/literal value judgment/note only.');const reason=body.reason_code??null;if(reason!==null&&!REASONS.includes(reason))throw invalid('Choose fear, hesitation, distraction, other or unknown.');if(body.decision==='missed_value'&&(body.value_setup!==true||!reason||!body.note.trim()))throw invalid('A missed-value report needs your explicit own-plan value judgment, reason and honest note; no unused-signal inference.');if(body.decision==='not_value'&&body.value_setup!==false)throw invalid('Explicit not-value requires false, not a guessed judgment.');return {decision:body.decision,value_setup:body.value_setup===null?null:body.value_setup?1:0,reason_code:reason,note:body.note.trim()};}
