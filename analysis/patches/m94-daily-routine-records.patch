index 0000000..bbcb298
--- /dev/null
+++ b/src/routine-records.js
@@ -0,0 +1,25 @@
+'use strict';
+/** M14/M94: explicit daily facts and descriptive outcomes. Self-reports never
+ * satisfy a workflow gate. NULL/unrecorded stays unknown, not skipped/complete.
+ * UTC close-day realised P&L, no inferential/causal/strategy-sizing claim. */
+const {db}=require('./db');const {dayKey,msOf}=require('./bots/guardrails');
+function input(message,status=400){const e=new Error(message);e.status=status;e.code='routine_input_invalid';return e;}
+function dateKey(value){if(typeof value!=='string'||!/^\d{4}-\d{2}-\d{2}$/.test(value)||!Number.isFinite(msOf(value))||dayKey(msOf(value))!==value)throw input('A valid UTC calendar date is required.');return value;}
+function parseFlag(value){if(value===null)return null;if(typeof value!=='boolean')throw input('pre_market_done must be an explicit true, false or null/unknown.');return value?1:0;}
+async function owned(store,userId,accountId=null){
+  let row;if(accountId==null||accountId==='')row=await store.prepare('SELECT * FROM accounts WHERE user_id=? ORDER BY archived,is_default DESC,id LIMIT 1').get(userId);
+  else{if(typeof accountId==='boolean'||!Number.isSafeInteger(Number(accountId))||Number(accountId)<=0)throw input('Account not found',404);row=await store.prepare('SELECT * FROM accounts WHERE id=? AND user_id=?').get(Number(accountId),userId);}
+  if(!row)throw input('Account not found',404);return row;
+}
+function publicRecord(row,date,accountId){return {date,account_id:accountId,done:row?.pre_market_done==null?null:row.pre_market_done===1,basis:row?.basis||'unrecorded',recorded_at:row?.recorded_at||null,workflow_complete:false,scope:'Daily self-reported fact, not derived workflow or reusable permission; NULL means unknown'};}
+async function daily(userId,{accountId=null,date,store=db}={}){date=dateKey(date);const acc=await owned(store,userId,accountId),row=await store.prepare('SELECT * FROM routine_day_records WHERE user_id=? AND account_id=? AND rule_date=?').get(userId,acc.id,date);return publicRecord(row,date,acc.id);}
+async function setManual(store,userId,accountId,date,value){date=dateKey(date);const done=parseFlag(value);if(done!==null && date>dayKey(Date.now()))throw input('Future routine completion/skipping cannot be recorded as an actual daily fact.');await owned(store,userId,accountId);await store.prepare(`INSERT INTO routine_day_records(user_id,account_id,rule_date,pre_market_done,basis,recorded_at) VALUES (?,?,?,?,?,?) ON CONFLICT(user_id,account_id,rule_date) DO UPDATE SET pre_market_done=excluded.pre_market_done,basis=excluded.basis,recorded_at=excluded.recorded_at`).run(userId,accountId,date,done,'self_reported',new Date().toISOString());return daily(userId,{accountId,date,store});}
+async function list(userId,{accountId=null,store=db}={}){const acc=await owned(store,userId,accountId),rows=await store.prepare('SELECT * FROM routine_day_records WHERE user_id=? AND account_id=? ORDER BY rule_date DESC LIMIT 400').all(userId,acc.id);return rows.map(r=>publicRecord(r,r.rule_date,acc.id));}
+async function report(userId,{accountId=null,from=null,to=null,store=db,nowMs=Date.now()}={}){
+  if(from)dateKey(from);if(to)dateKey(to);if(from&&to&&from>to)throw input('from must not be after to.');const acc=await owned(store,userId,accountId),rows=await store.prepare("SELECT * FROM trades WHERE user_id=? AND account_id=? AND status='closed'").all(userId,acc.id),records=await store.prepare('SELECT * FROM routine_day_records WHERE user_id=? AND account_id=?').all(userId,acc.id),byDate=new Map(records.map(r=>[r.rule_date,r])),grouped=new Map(),unassigned=[];
+  for(const t of rows){const ms=msOf(t.closed_at);if(!Number.isFinite(ms)){unassigned.push(t.id);continue;}if(ms>nowMs)continue;const date=dayKey(ms);if((from&&date<from)||(to&&date>to))continue;if(!grouped.has(date))grouped.set(date,[]);grouped.get(date).push(t);}
+  const days=[...grouped].map(([date,trades])=>{const known=trades.every(t=>t.net_pnl!==null&&t.net_pnl!==undefined&&t.net_pnl!==''&&Number.isFinite(Number(t.net_pnl))),r=publicRecord(byDate.get(date),date,acc.id);return {date,trades:trades.length,realised_pnl:known?trades.reduce((s,t)=>s+Number(t.net_pnl),0):null,pre_market:r,status:r.done===null?'unknown':r.done?'completed':'not_completed'};}).sort((a,b)=>a.date.localeCompare(b.date));
+  const buckets=['completed','not_completed','unknown'].map(status=>{const all=days.filter(d=>d.status===status),known=all.filter(d=>d.realised_pnl!==null),net=known.reduce((s,d)=>s+d.realised_pnl,0);return {status,days:all.length,known_pnl_days:known.length,unavailable_pnl_days:all.length-known.length,net_pnl:known.length?net:null,mean_daily_pnl:known.length?net/known.length:null};});
+  return {account_id:acc.id,timezone:'UTC',days,buckets,total_closed_trades:days.reduce((s,d)=>s+d.trades,0),unassigned_close_date_ids:unassigned,descriptive_only:true,causation_established:false,note:'Observational self-reported routine/day P&L buckets, trading days only. Unknown is not skipped, missing P&L is not zero; small/selected samples and retrospective self-reports do not prove causation or justify resizing/strategy tuning.'};
+}
+module.exports={input,dateKey,parseFlag,owned,daily,setManual,list,report};
