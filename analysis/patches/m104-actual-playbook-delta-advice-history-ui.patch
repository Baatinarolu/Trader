+/* M104 recorded APP units, not independent causal variables or authority. */
+(function(global){
+ 'use strict';const Views=global.Views=global.Views||{},U=global.U;let serial=0;
+ const ctx=()=>({user:global.Store.user?.id,account:global.Store.accountId,token:global.API.getToken()}),same=c=>c.user===global.Store.user?.id&&c.account===global.Store.accountId&&c.token===global.API.getToken(),finite=n=>typeof n==='number'&&Number.isFinite(n);
+ const P=Views.ruleChanges={ctx,same,nextSerial:()=>++serial,current:n=>n===serial,
+  card(report){const node=U.h('section',{class:'card',style:'margin-top:12px',dataset:{ruleChangeGuidance:'true'}});node.appendChild(U.h('h3',{text:'Quarterly rule-change discipline — all owned strategies'}));node.appendChild(U.h('p',{class:'field-note',text:'APP edit units, not verified independent causal variables. UTC calendar quarter across all owned strategies. One change recommended, three maximum guidance; warnings do not block/clamp a trade, grade or risk setting. Cosmetic names/colours/pause excluded. Each saved change/reversal counts; absence is not a historical untouched-plan certificate.'}));const total=finite(report?.total_units)?String(report.total_units):'Unavailable';node.appendChild(U.h('p',{class:'small',text:`Quarter ${report?.quarter?.start||'unavailable'} to ${report?.quarter?.end||'unavailable'} (UTC, end exclusive) · full count ${total} · known recorded minimum ${finite(report?.known_units)?report.known_units:'Unavailable'}. ${report?.state==='unavailable'?'History incomplete; not certified within three.':''}`}));node.appendChild(U.h('p',{class:'sticky-note warn',text:report?.warning||'Unavailable rule history; not certified zero/within three.'}));for(const c of report?.changes||[]){const body=U.h('details');body.appendChild(U.h('summary',{text:`${c.strategy_name||'Historical setup'} · v${c.from_version} → v${c.to_version} · ${c.delta.units} units · ${c.recorded_at} · ${c.source}${c.orphaned?' · strategy removed, count retained':''}`}));body.appendChild(P.delta(c.delta));node.appendChild(body);}return node;},
+  delta(d){const node=U.h('section',{class:'small'});if(!d||d.units===null)node.appendChild(U.h('p',{text:'Proposed edit units unavailable; no zero/within-budget inference.'}));for(const change of d?.changes||[]){node.appendChild(U.h('p',{text:`${change.field}: ${change.units} APP unit${change.units===1?'':'s'}` }));if(change.removed?.length)node.appendChild(U.h('p',{text:'Removed: '+change.removed.join(' · ')}));if(change.added?.length)node.appendChild(U.h('p',{text:'Added: '+change.added.join(' · ')}));if(change.reordered)node.appendChild(U.h('p',{text:'Order changed (one APP unit, no added/removed rule text).'}));if(change.before!==undefined)node.appendChild(U.h('p',{text:'Before: '+change.before+' · after: '+change.after}));}if(d?.units===0)node.appendChild(U.h('p',{text:'0 proposed APP units: no recorded rule-line/scalar change. Existing quarter history is still separate.'}));return node;},
+  preview(view){const p=view.preview,node=U.h('div',{dataset:{ruleChangePreview:'true'}});node.appendChild(U.h('h3',{text:`${p.proposed.units??'Unavailable'} proposed APP edit units`}));node.appendChild(U.h('p',{class:'field-note',text:p.proposed.basis}));node.appendChild(P.delta(p.proposed));node.appendChild(U.h('p',{class:'sticky-note warn',text:p.warning}));node.appendChild(P.card(p.current));node.appendChild(U.h('p',{class:'small',text:'Preview is readonly. No trade, grade, risk, rule or version changed yet. Continuing records the shown configuration, not proof of a successful experiment.'}));return node;},
