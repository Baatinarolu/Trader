+/**
+ * M13/M65 — the WEEKLY and QUARTERLY series, beside daily/monthly.
+ *
+ * The review system has spoken in weeks and quarters since M99/M101 while the numbers below it could
+ * only be bucketed by day and by month, so the review cadence had no series of its own. These two use
+ * the REVIEW's calendar (`src/periods.js`: UTC close-day, Monday-start weeks, calendar quarters) — the
+ * same ruler `period-reviews.js` filters a period by — which is NOT the ruler `dailySeries` and
+ * `monthlySeries` use above (they bucket by the journal timezone's close-day). Two rulers, both
+ * labelled, and nothing here converts a trade from one into the other.
+ *
+ * Three honesty rules, because a bucket is presented as a fact about a period:
+ *   - a close with no recorded clock is NOT guessed into a week: it is skipped here and counted in
+ *     `undated_closes` on the payload, which is the only place it can be seen at all;
+ *   - a bucket whose closes carry no recorded net (or no recorded R) reports `null`, not `0` — a
+ *     missing number is not a flat week;
+ *   - `unknown_net`/`unknown_r` count those closes per bucket, and the win rate divides by the closes
+ *     that HAVE a known net, so one unreported close cannot be read as a loss.
+ */
+function periodSeries(closed, kind) {
+  const out = {};
+  for (const t of closed) {
+    const ms = Date.parse(t.closed_at);
+    if (!Number.isFinite(ms)) continue;
+    const day = Periods.dayOf(ms), key = Periods.bucketOf(kind, day);
+    if (!out[key]) {
+      const p = Periods.period(kind, day);
+      out[key] = { [kind]: key, start: p.start, end: p.end, last_day: p.last_day, pnl: 0, r: 0, trades: 0, wins: 0, losses: 0, breakeven: 0, unknown_net: 0, unknown_r: 0, days: 0, _days: new Set() };
+    }
+    const o = out[key];
+    o.trades += 1;
+    o._days.add(day);
+    const net = t.net_pnl;
+    if (net === null || net === undefined || net === '' || isNaN(Number(net))) o.unknown_net += 1;
+    else { const v = Number(net); o.pnl += v; if (v > 0) o.wins += 1; else if (v < 0) o.losses += 1; else o.breakeven += 1; }
+    const r = t.r_multiple;
+    if (r === null || r === undefined || r === '' || isNaN(Number(r))) o.unknown_r += 1; else o.r += Number(r);
+  }
+  for (const k of Object.keys(out)) {
+    const o = out[k];
+    o.days = o._days.size; delete o._days;
+    o.pnl = o.unknown_net === o.trades ? null : r2(o.pnl);
+    o.r = o.unknown_r === o.trades ? null : r4(o.r);
+    const known = o.trades - o.unknown_net;
+    o.win_rate = known ? r2((o.wins / known) * 100) : null;
+    o.basis = 'UTC close-day, ' + (kind === 'week' ? 'Monday-start week' : 'calendar quarter') + ' (the review calendar; the daily/monthly series above use the journal timezone).';
+  }
+  return Object.fromEntries(Object.entries(out).sort(([a], [b]) => a.localeCompare(b)));
+}
+
+function weeklySeries(closed) { return periodSeries(closed, 'week'); }
+
+function quarterlySeries(closed) { return periodSeries(closed, 'quarter'); }
