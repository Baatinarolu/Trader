+/** One bounded, single-line question: plain text only, no markup, no control characters. */
+function question(value) {
+  if (typeof value !== 'string' || !value.trim()) throw invalid(`Type a question of up to ${CHAR_MAX} characters.`);
+  if (value.length > CHAR_MAX) throw invalid(`Keep the question to ${CHAR_MAX} characters or fewer.`);
+  if (/[\x00-\x1f\x7f]/.test(value)) throw invalid('The question must be one line of plain text: control characters are not accepted.');
+  if (/<\s*[a-z!/]/i.test(value)) throw invalid('The question must be plain text: markup is not accepted.');
+  return value.normalize('NFC').trim();
