+++ b/src/ask.js
@@ -0,0 +1,398 @@
+'use strict';
+/**
+ * M109 — the advisory channel: ask the journal what it already knows.
+ *
+ * Saved Ep29 (Flow AI): "the real edge of AI is speed. It helps you close the gap faster
+ * between confusion and clarity, emotion and logic, mistake and lesson, impulse and
+ * discipline", and the channel's moment is mid-session: "come to Flow AI. Flow AI will
+ * ground you." The same episode draws the line this module refuses to cross: "AI should
+ * not replace your trade plan. It should not replace your journaling. It should not
+ * replace your review process. It should not replace your risk management. It should not
+ * replace your personal responsibility ... if you start using AI as a shortcut for
+ * certainty, you are using it wrong", and "AI is not the most powerful when it tries to
+ * predict the market for you. Trust me, I've tried it."
+ *
+ * So this is NOT an AI and claims none of the perks: there is no model, no API key, no
+ * network call and no new data. It is a deterministic question router over findings the
+ * app has ALREADY computed and stored - the coach's own insights, the guardrail state the
+ * entry engine reads, and the trader's own records (M64 routine, M106 gate, M107
+ * intention, M108 practice). Same stored state + same question answers the same bytes.
+ *
+ * Three properties are structural, not promises:
+ *   1. READ-ONLY. Every reader below is a SELECT (or a module's documented read path).
+ *      Asking cannot create, repair, latch or acknowledge anything, so a question can
+ *      never become a permission or an admission record.
+ *   2. NO PREDICTION, NO PERMISSION, NO OVERRIDE. Direction/odds questions, "should I
+ *      trade" questions, mental-state questions and "change my limits" questions are
+ *      REFUSED with a named code and the episode's own reason - they are not answered
+ *      with invented content, and a refusal is a successful answer, not an error.
+ *   3. NOTHING INVENTED. Missing, unreadable or never-fetched inputs are reported as
+ *      `unavailable` with the reason; unknown is never rendered as zero, "no news" or
+ *      "all clear". Every line carries its provenance, and the limits travel with the
+ *      answer.
+ *
+ * Authority: none. No score, no grade, no signal, no direction, no risk change, no
+ * admission, no veto, no override. The entry engine remains the only authority and this
+ * channel cannot move it.
+ */
+const P = require('./performance');
+const Coach = require('./coach');
+const Guards = require('./bots/guardrails');
+const StateGate = require('./state-gate');
+const Intention = require('./intention');
+
+const VERSION = 'ask-v1';
+const CHAR_MAX = 280;
+const TOPIC_LIMIT = 6;
+/** There is no provider, key, model or socket behind this module — stated as a constant
+ * so a regression that added one would have to change this file's own contract. */
+const LLM = false;
+const BASIS = 'A deterministic, read-only question channel over findings this app already computed: the coach insights, the guardrail/cap state the entry engine reads, and the trader\'s own records (routine, state gate, intention, practice). No model, no key, no network, no new data, no prediction, no permission, no override. Refusals are answers; unknown stays unknown.';
+
+/* ------------------------------------------------------------------ doctrine */
+/** The episode's own words, kept verbatim as the reason a refusal is a refusal. */
+const DOCTRINE = {
+  no_replace: 'AI should not replace your trade plan. It should not replace your journaling. It should not replace your review process. It should not replace your risk management. It should not replace your personal responsibility.',
+  no_certainty: 'If you start using AI as a shortcut for certainty, you are using it wrong.',
+  no_predict: 'AI is not the most powerful when it tries to predict the market for you. Trust me, I\'ve tried it.',
+  grounding: 'When you are trading ... come to Flow AI. Flow AI will ground you.',
+};
+
+/* ------------------------------------------------------- bounded classifier */
+/* The same cue families M107's bounded classifier uses, applied to a question instead of
+ * an intention. These are pattern families, not an understanding of language: a question
+ * that trips one is refused with the reason, and one that trips none is answered only if
+ * it also matches a known topic — otherwise the channel says it does not know. */
+const AMOUNT = /(?:[$€£]\s?\d[\d,.]*)|(?:\b\d[\d,.]*\s?(?:usd|eur|gbp|dollars?|euros?|pounds?|naira|k)\b)|(?:\b\d+(?:\.\d+)?\s?%)/i;
+const PREDICTION = /(\bgoing to (?:go|rise|fall|drop|moon|pump|dump|happen)\b|\bwill (?:it|price|the market|the pair|the dollar|gold|bitcoin|btc|eth|[a-z]{3}\/[a-z]{3}|[a-z]{6})\b|\bmarket will\b|\bprice will\b|\bpredict|\bforecast|\bprice target\b|\btarget price\b|\bwhere (?:is|will|does) (?:price|it|the market)\b|\bmoon\b|\bpump\b|\bdump\b|\bhow high\b|\bhow low\b|\bwhen will\b|\bwhat will happen\b|\bnext move\b|\bodds\b|\bprobability\b|\bchance(?:s)?\b)/i;
+/* A decision question is an interrogative aimed at ACTING, not at reading: "should I take
+ * this trade" refuses, while "can I see my risk limits" is a legitimate read request and
+ * must never be refused just because it shares the word "trade" or "risk" with a decision.
+ * So the verbs here are unambiguous actions, and the noun-ish cues (trade/trades, risk,
+ * limits, signal on its own) are deliberately NOT decision verbs. */
+const INTERROGATIVE = /\b(?:should|shall|can|could|may|would|will)\s+(?:i|we|you)\b/i;
+const DECISION_VERB = /\b(?:enter|exit|close|buy|sell|long|short|skip|take (?:this|that|the) (?:trade|setup|entry)|open (?:a )?position|add to (?:the )?position|hold (?:this|that|it)|size (?:up|down)|give me a (?:signal|trade|setup)|permission|allowed)\b/i;
+const DECIDE = /(\bwhat should (?:i|we) (?:trade|buy|sell)\b|\bwhich (?:trade|setup|pair|instrument|symbol) should\b|\bis (?:this|it|that) (?:a )?(?:good|safe|ok|okay|worthwhile) (?:trade|entry|setup|idea)\b|\bworth (?:taking|the entry|this trade)\b|\bgive me a (?:signal|trade|setup)\b|\bam i (?:allowed|clear|good|ok|okay)\b|\bare we (?:allowed|clear|good|ok|okay)\b|\bdo you (?:think|reckon) (?:i|we) should\b|\bpermission to (?:trade|enter)\b|\ballowed to (?:trade|enter|buy|sell)\b)/i;
+const PERMISSION = { test: (q) => DECIDE.test(q) || (INTERROGATIVE.test(q) && DECISION_VERB.test(q)) };
+const OVERRIDE = /(\b(?:change|raise|lower|increase|decrease|edit|set|remove|disable|turn off|ignore|bypass|override|skip|unlock|reset)\b)/i;
+const OVERRIDE_TARGET = /(\brisk\b|\bcap\b|\blimit\b|\bguardrail|\bkillzone\b|\bnews\b|\bblock\b|\bstop\b|\broutine\b|\brule|\bsize\b|\bleverage\b|\bdaily loss\b|\bdrawdown\b|\bprofit\b)/i;
+const MENTAL_STATE = /(\bcalm\b|\btilt(?:ed)?\b|\bdisciplined\b|\banxious\b|\bgreedy\b|\bfearful\b|\bangry\b|\bmental(?: state)?\b|\bemotion(?:al)? state\b|\bfomo\b|\bhow (?:do|am) i feel|\bam i (?:focused|ready|ok|okay|good enough|in the right|strong enough)\b|\bfocused enough\b|\bis my (?:mind|head|state)\b|\bgrounded\b|\bstate of mind\b|\bright (?:mindset|head)\b|\bam i being\b)/i;
