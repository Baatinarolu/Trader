+
+function riskLines(ctx) {
+  if (!ctx.account) return [unavailable('No account is selected, so risk limits cannot be reported.', 'accounts:owned')];
+  const a = ctx.account;
+  const lines = [
+    fact(`Risk per trade: ${pct(a.risk_per_trade_pct)}${a.risk_unlocked ? ' (the 1% manual unlock is currently on)' : ' (unlock off: the app guardrail clamps this)'} — account policy, not changed by anything asked here.`, 'accounts:risk_per_trade_pct'),
+    fact(`Max trades/day: ${ctx.caps ? ctx.caps.max_trades_day + ' selected for ' + ctx.day : Guards.configuredCap(a) + ' (account policy; no caps row stored yet today)'}.`, 'guardrail_day_caps:max_trades_day'),
+    fact(`Daily loss limit: ${pct(a.daily_loss_limit_pct)} of starting balance; max drawdown ${pct(a.max_drawdown_pct)}; lifetime profit target ${pct(a.profit_target_pct)}.`, 'accounts:daily_loss_limit_pct'),
+    fact(`Open positions: ${ctx.open.length}; today's realised net on this account: ${money(ctx.closed.filter((t) => t.day === ctx.day).reduce((s, t) => s + (Number(t.net_pnl) || 0), 0))}.`, 'trades:today'),
+    note('No streak-based resizing: win/loss streaks are history and never move the risk unit (the selected risk/checklist sizing and the separate drawdown/day-loss controls own that).', 'bots/guardrails:streaks'),
+  ];
+  return lines;
+}
+
+/* ------------------------------------------------------------------- surface */
+function meta() {
+  return {
+    version: VERSION, llm: LLM, model: null, api_key_required: false, network: false,
+    deterministic: 'same stored state + same question -> same answer',
+    reads_only: true, writes: 0, new_data: false, predicts: false, grants_permission: false,
+    gives_direction_or_signal: false, changes_limits: false, authority: 'none',
+    answers_from: 'findings this app already computed and stored (coach insights, guardrail/cap state, the trader\'s own records)',
+  };
+}
+
+async function topics() {
+  return {
+    version: VERSION, basis: BASIS, topics: TOPICS.map((t) => ({ id: t.id, label: t.label, example: t.example })),
+    refusal_codes: REFUSALS.map((r) => r.code), cannot_know: CANNOT_KNOW, meta: meta(),
+  };
+}
+
+async function ask(userId, body, { db, nowMs = Date.now(), timezone = 'UTC' } = {}) {
+  const text = question(body && typeof body === 'object' ? body.question : body);
+  const routed = route(text);
+  const base = { version: VERSION, question: text, cannot_know: CANNOT_KNOW, meta: meta() };
+  if (routed.refusal) {
+    const family = REFUSALS.find((r) => r.code === routed.refusal) || REFUSALS[0];
+    return { ...base, answered: false, refused: true, topic: null,
+      refusal: { code: family.code, because: family.because, cites: family.cites, can_answer: family.can_answer, cues: routed.cues, intention_cues: routed.intention_cues },
+      answer: [note(`Not answered, on purpose. ${family.because}`, family.code)] };
+  }
+  if (!routed.topic) {
+    return { ...base, answered: false, refused: false, topic: null,
+      reason: { code: 'no_matching_topic', because: 'This channel answers from a fixed set of surfaces it actually owns, and the question did not land on one of them. It will not invent an answer.', topics: TOPICS.map((t) => t.id) },
+      answer: [note('I do not know how to answer that from stored facts, so I am not answering it at all.', 'ask:no_matching_topic')] };
+  }
+  let ctx;
+  try { ctx = await context(db, userId, { nowMs, timezone }); }
+  catch (e) {
+    return { ...base, answered: true, refused: false, topic: routed.topic, topic_label: (TOPICS.find((t) => t.id === routed.topic) || {}).label || null,
+      answer: [unavailable(`The stored facts for that surface could not be read (${e && e.message ? String(e.message).slice(0, 120) : 'unknown error'}), so they are reported unavailable with the reason — nothing is answered from a guess, and nothing is repaired.`, 'ask:read_failed')] };
+  }
+  const reader = READERS[routed.topic];
+  let answer;
+  try { answer = await reader(ctx); }
+  catch (e) { answer = [unavailable(`That surface could not be read (${e && e.message ? String(e.message).slice(0, 120) : 'unknown error'}), so it is reported unavailable rather than answered from a guess.`, 'ask:read_failed')]; }
+  const topic = TOPICS.find((t) => t.id === routed.topic);
+  return { ...base, answered: true, refused: false, topic: topic.id, topic_label: topic.label, cues: routed.cues, intention_cues: routed.intention_cues, answer };
+}
+
+module.exports = { VERSION, CHAR_MAX, BASIS, DOCTRINE, LLM, TOPICS, CANNOT_KNOW, REFUSALS, question, route, meta, topics, ask, context };
