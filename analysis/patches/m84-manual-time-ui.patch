+  Views.sessionTimeCard = function(session = {}) {
+    const accountId=Number(session.account_id || Store.accountId),node=U.h('div',{class:'card',style:'margin-top:14px','data-session-time':''});
+    function draw(s){
+      const ongoing=!!s.started_at && !s.ended_at;
